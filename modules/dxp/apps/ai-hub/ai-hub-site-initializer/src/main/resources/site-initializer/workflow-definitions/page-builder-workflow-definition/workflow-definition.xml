<?xml version="1.0"?>

<workflow-definition
	xmlns="urn:liferay.com:liferay-workflow_7.4.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="urn:liferay.com:liferay-workflow_7.4.0 http://www.liferay.com/dtd/liferay-workflow-definition_7_4_0.xsd"
>
	<name>Page Builder</name>
	<version>1</version>
	<tool>
		<name>fragmentLoader</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						300,
						200
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				Fragment Loader
			</label>
		</labels>
		<tool-name>getFragments</tool-name>
		<input-variables><![CDATA[[{"name":"siteExternalReferenceCode","type":"string"}]]]></input-variables>
		<output-variables><![CDATA[[{"name":"rawFragments","type":"string"}]]]></output-variables>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						Catalog Builder
					</label>
				</labels>
				<name>catalogBuilder</name>
				<target>catalogBuilder</target>
				<default>true</default>
			</transition>
		</transitions>
	</tool>
	<tool>
		<name>catalogBuilder</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						300,
						275
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				Catalog Builder
			</label>
		</labels>
		<tool-name>buildCatalog</tool-name>
		<input-variables><![CDATA[[{"name":"siteExternalReferenceCode","type":"string"},{"name":"rawFragments","type":"string"}]]]></input-variables>
		<output-variables><![CDATA[[{"name":"fragmentCatalog","type":"string"}]]]></output-variables>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						Page Fetcher
					</label>
				</labels>
				<name>pageFetcher</name>
				<target>pageFetcher</target>
				<default>true</default>
			</transition>
		</transitions>
	</tool>
	<tool>
		<name>pageFetcher</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						300,
						350
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				Page Fetcher
			</label>
		</labels>
		<tool-name>getPageSpecification</tool-name>
		<input-variables><![CDATA[[{"name":"siteExternalReferenceCode","type":"string"},{"name":"sitePageExternalReferenceCode","type":"string"}]]]></input-variables>
		<output-variables><![CDATA[[{"name":"currentPageSpecification","type":"string"}]]]></output-variables>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						Page Spec To IR
					</label>
				</labels>
				<name>pageSpecToIR</name>
				<target>pageSpecToIR</target>
				<default>true</default>
			</transition>
		</transitions>
	</tool>
	<tool>
		<name>pageSpecToIR</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						300,
						500
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				Page Spec To IR
			</label>
		</labels>
		<tool-name>convertToIR</tool-name>
		<input-variables><![CDATA[[{"name":"currentPageSpecification","type":"string"},{"name":"pageTitle","type":"string"},{"name":"locale","type":"string"}]]]></input-variables>
		<output-variables><![CDATA[[{"name":"currentPageIR","type":"string"}]]]></output-variables>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						Page Builder
					</label>
				</labels>
				<name>pageBuilder</name>
				<target>pageBuilder</target>
				<default>true</default>
			</transition>
		</transitions>
	</tool>
	<llm>
		<name>pageBuilder</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						300,
						650
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				Page Builder
			</label>
		</labels>
		<input-variables>
			<![CDATA[
[
	{
		"name": "currentPageIR",
		"type": "string"
	},
	{
		"name": "fragmentCatalog",
		"type": "string"
	},
	{
		"name": "request",
		"type": "string"
	}
]
]]>
		</input-variables>
		<output-variables>
			<![CDATA[
[
	{
		"name": "updatedPageIR",
		"type": "string"
	}
]
]]>
		</output-variables>
		<prompt>
			<![CDATA[You edit a page IR JSON. Given an instruction and current IR, output the FULL updated IR JSON. No markdown, no prose — raw JSON only.

IR: {"title":"…","erc":"…","locale":"en-US","elements":[Container|Grid|Fragment]}

Container: {"type":"container","erc":"<id>","contentDisplay?":"flex-row|flex-column","widthType?":"fixed","padding?":{"top":5,"bottom":5,"left":5,"right":5},"margin?":{"top":0,"bottom":0},"backgroundColor?":"<color>","textColor?":"<color>","textAlign?":"center|left|right","children":[…]}
Only type+erc required. Default padding=5, contentDisplay=block.

Grid: {"type":"grid","erc":"<id>","gutters?":true,"modulesPerRow?":{"desktop":3,"tablet":2,"mobile":1},"columns":[{"size":4,"children":[…]}]}
Column size 1–12. N equal cols → size=floor(12/N).

Fragment: {"type":"fragment","erc":"<id>","source":"ootb|custom","key":"<name>","content?":{"<editableId>":<val>},"style?":{"backgroundColor":"<color>","textAlign":"center","padding":{"top":3}}}

OOTB fragments: heading→element-text(text), paragraph→element-text(richText), card→01-img(image)+02-title(richText)+03-content(richText)+04-link(link), image→image-square(image), button→element-text(text)+element-link(link), video→element-video(link), spacer, separator.

Custom fragments: use externalReferenceCode from fragmentCatalog as key, source="custom", editables from catalog.

Values: text="string", richText="<p>html</p>", image={"url":"…"} or "url", link={"text":"…","url":"…","target?":"blank"} or "url".

Colors: primary,secondary,success,danger,warning,info,dark,light,white,black,gray000–gray900. Spacing: 0–10.

ERCs: new elements get stable names (heading-1, card-1, section-1, grid-cards). Reuse existing ERCs on unchanged elements.

Rules: output FULL IR (not diff), preserve existing ERCs, only add Container/Grid when layout requested, only use listed fragment keys, error→{"_error":"reason"}.

Example: instruction="Add a heading saying Hello World", empty page → {"title":"My Page","erc":"my-page","locale":"en-US","elements":[{"type":"fragment","erc":"heading-1","source":"ootb","key":"heading","content":{"element-text":"Hello World"}}]}]]>
		</prompt>
		<tools>
			<![CDATA[[]]]>
		</tools>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						IR To Page Spec
					</label>
				</labels>
				<name>irToPageSpec</name>
				<target>irToPageSpec</target>
				<default>true</default>
			</transition>
		</transitions>
		<user-message>
			<![CDATA[Instruction: {{request}}

fragmentCatalog: {{fragmentCatalog}}

current_page_ir: {{currentPageIR}}]]>
		</user-message>
	</llm>
	<tool>
		<name>irToPageSpec</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						300,
						800
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				IR To Page Spec
			</label>
		</labels>
		<tool-name>convertToPageSpec</tool-name>
		<input-variables><![CDATA[[{"name":"updatedPageIR","type":"string"},{"name":"draftERC","type":"string"},{"name":"experienceERC","type":"string"},{"name":"locale","type":"string"}]]]></input-variables>
		<output-variables><![CDATA[[{"name":"response","type":"string"}]]]></output-variables>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						Page Updater
					</label>
				</labels>
				<name>pageUpdater</name>
				<target>pageUpdater</target>
				<default>true</default>
			</transition>
		</transitions>
	</tool>
	<tool>
		<name>pageUpdater</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						300,
						950
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				Page Updater
			</label>
		</labels>
		<tool-name>updatePageSpecification</tool-name>
		<input-variables><![CDATA[[{"name":"siteExternalReferenceCode","type":"string"},{"name":"sitePageExternalReferenceCode","type":"string"},{"name":"response","type":"string"}]]]></input-variables>
		<output-variables><![CDATA[[{"name":"updatedPageSpecification","type":"string"}]]]></output-variables>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						End
					</label>
				</labels>
				<name>end</name>
				<target>end</target>
				<default>true</default>
			</transition>
		</transitions>
	</tool>
	<state>
		<name>start</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						300,
						50
					]
				}
			]]>
		</metadata>
		<initial>true</initial>
		<labels>
			<label language-id="en_US">
				Start
			</label>
		</labels>
		<transitions>
			<transition>
				<labels>
					<label language-id="en_US">
						Fragment Loader
					</label>
				</labels>
				<name>fragmentLoader</name>
				<target>fragmentLoader</target>
				<default>true</default>
			</transition>
		</transitions>
	</state>
	<state>
		<name>end</name>
		<metadata>
			<![CDATA[
				{
					"terminal": true,
					"xy": [
						300,
						1100
					]
				}
			]]>
		</metadata>
		<labels>
			<label language-id="en_US">
				End
			</label>
		</labels>
	</state>
</workflow-definition>
